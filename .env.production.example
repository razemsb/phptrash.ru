# Production template — copy to server as .env (never commit real .env)
# Local uses .env with DB_DATABASE=phptrash.ru
# Production uses this shape with Reg.ru credentials

APP_NAME=api.phptrash.ru
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.phptrash.ru

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u3605906_phptrash.ru
DB_USERNAME=u3605906_phptrash
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@phptrash.ru"
MAIL_FROM_NAME="${APP_NAME}"
